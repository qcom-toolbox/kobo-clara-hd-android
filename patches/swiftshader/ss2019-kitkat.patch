@@ -295,6 +295,13 @@ enum { MaxCacheLineSize = 64 };
 // list to be aligned to the next cache line.
 #if defined(_MSC_VER)
 #define ICE_CACHELINE_BOUNDARY __declspec(align(MaxCacheLineSize)) int : 0;
+#elif defined(__ANDROID__) && defined(__arm__)
+// Kobo/KitKat: bionic malloc (and pre-C++17 operator new) only guarantees
+// 8-byte alignment, but these over-aligned members make the compiler emit
+// 128-bit-aligned NEON stores into heap objects -> SIGBUS (BUS_ADRALN).
+// The padding only avoids false sharing between cores; the target is
+// single-core, so drop it.
+#define ICE_CACHELINE_BOUNDARY int : 0
 #else // !defined(_MSC_VER)
 // Note: zero is added to work around the following GCC 4.8 bug (fixed in 4.9):
 //       https://gcc.gnu.org/bugzilla/show_bug.cgi?id=55382
