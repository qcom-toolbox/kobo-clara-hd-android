+// Runtime helpers for JIT code on ARM cores without hardware divide (the
+// Kobo's Cortex-A9). Subzero lowers these operations to calls by name; the
+// ELF loader below resolves the names through this table. Subzero emits
+// hard-float calls while Android armeabi-v7a C code is soft-float, so every
+// helper that passes floats/vectors is declared aapcs-vfp. Function pointers
+// keep the Thumb bit, which the MOVW/MOVT relocation preserves, so the
+// generated BLX switches to Thumb correctly.
+#include <cstring>
+#include <cmath>
+#include <android/log.h>
+namespace
+{
+	#define SZ_HARDFP __attribute__((pcs("aapcs-vfp")))
+	typedef float sz_v4f __attribute__((vector_size(16)));
+	typedef uint32_t sz_v4u __attribute__((vector_size(16)));
+
+	int32_t sz_divsi3(int32_t a, int32_t b) { return a / b; }
+	uint32_t sz_udivsi3(uint32_t a, uint32_t b) { return a / b; }
+	int32_t sz_modsi3(int32_t a, int32_t b) { return a % b; }
+	uint32_t sz_umodsi3(uint32_t a, uint32_t b) { return a % b; }
+	int64_t sz_divdi3(int64_t a, int64_t b) { return a / b; }
+	uint64_t sz_udivdi3(uint64_t a, uint64_t b) { return a / b; }
+	int64_t sz_moddi3(int64_t a, int64_t b) { return a % b; }
+	uint64_t sz_umoddi3(uint64_t a, uint64_t b) { return a % b; }
+	int32_t sz_popcountsi2(uint32_t a) { return __builtin_popcount(a); }
+	int32_t sz_popcountdi2(uint64_t a) { return __builtin_popcountll(a); }
+
+	SZ_HARDFP float sz_fmodf(float a, float b) { return fmodf(a, b); }
+	SZ_HARDFP double sz_fmod(double a, double b) { return fmod(a, b); }
+	SZ_HARDFP int64_t sz_fptosi_f32_i64(float a) { return (int64_t)a; }
+	SZ_HARDFP int64_t sz_fptosi_f64_i64(double a) { return (int64_t)a; }
+	SZ_HARDFP uint32_t sz_fptoui_f32_i32(float a) { return (uint32_t)a; }
+	SZ_HARDFP uint64_t sz_fptoui_f32_i64(float a) { return (uint64_t)a; }
+	SZ_HARDFP uint32_t sz_fptoui_f64_i32(double a) { return (uint32_t)a; }
+	SZ_HARDFP uint64_t sz_fptoui_f64_i64(double a) { return (uint64_t)a; }
+	SZ_HARDFP float sz_sitofp_i64_f32(int64_t a) { return (float)a; }
+	SZ_HARDFP double sz_sitofp_i64_f64(int64_t a) { return (double)a; }
+	SZ_HARDFP float sz_uitofp_i32_f32(uint32_t a) { return (float)a; }
+	SZ_HARDFP double sz_uitofp_i32_f64(uint32_t a) { return (double)a; }
+	SZ_HARDFP float sz_uitofp_i64_f32(uint64_t a) { return (float)a; }
+	SZ_HARDFP double sz_uitofp_i64_f64(uint64_t a) { return (double)a; }
+	SZ_HARDFP sz_v4u sz_fptoui_4xi32_f32(sz_v4f a)
+	{
+		sz_v4u r;
+		for(int i = 0; i < 4; i++) r[i] = (uint32_t)a[i];
+		return r;
+	}
+	SZ_HARDFP sz_v4f sz_uitofp_4xi32_4xf32(sz_v4u a)
+	{
+		sz_v4f r;
+		for(int i = 0; i < 4; i++) r[i] = (float)a[i];
+		return r;
+	}
+
+	void *sz_resolveExternal(const char *name)
+	{
+		static const struct { const char *name; void *fn; } table[] =
+		{
+			{"__divsi3", (void*)sz_divsi3}, {"__udivsi3", (void*)sz_udivsi3},
+			{"__modsi3", (void*)sz_modsi3}, {"__umodsi3", (void*)sz_umodsi3},
+			{"__divdi3", (void*)sz_divdi3}, {"__udivdi3", (void*)sz_udivdi3},
+			{"__moddi3", (void*)sz_moddi3}, {"__umoddi3", (void*)sz_umoddi3},
+			{"__popcountsi2", (void*)sz_popcountsi2}, {"__popcountdi2", (void*)sz_popcountdi2},
+			{"fmodf", (void*)sz_fmodf}, {"fmod", (void*)sz_fmod},
+			{"memcpy", (void*)memcpy}, {"memmove", (void*)memmove}, {"memset", (void*)memset},
+			{"__Sz_fptosi_f32_i64", (void*)sz_fptosi_f32_i64},
+			{"__Sz_fptosi_f64_i64", (void*)sz_fptosi_f64_i64},
+			{"__Sz_fptoui_f32_i32", (void*)sz_fptoui_f32_i32},
+			{"__Sz_fptoui_f32_i64", (void*)sz_fptoui_f32_i64},
+			{"__Sz_fptoui_f64_i32", (void*)sz_fptoui_f64_i32},
+			{"__Sz_fptoui_f64_i64", (void*)sz_fptoui_f64_i64},
+			{"__Sz_sitofp_i64_f32", (void*)sz_sitofp_i64_f32},
+			{"__Sz_sitofp_i64_f64", (void*)sz_sitofp_i64_f64},
+			{"__Sz_uitofp_i32_f32", (void*)sz_uitofp_i32_f32},
+			{"__Sz_uitofp_i32_f64", (void*)sz_uitofp_i32_f64},
+			{"__Sz_uitofp_i64_f32", (void*)sz_uitofp_i64_f32},
+			{"__Sz_uitofp_i64_f64", (void*)sz_uitofp_i64_f64},
+			{"__Sz_fptoui_4xi32_f32", (void*)sz_fptoui_4xi32_f32},
+			{"__Sz_uitofp_4xi32_4xf32", (void*)sz_uitofp_4xi32_4xf32},
+		};
+		for(const auto &e : table)
+		{
+			if(strcmp(e.name, name) == 0) return e.fn;
+		}
+		__android_log_print(ANDROID_LOG_ERROR, "swiftshader", "JIT: unresolved external symbol '%s'", name);
+		return nullptr;
+	}
+}
+#endif  // defined(__arm__)
